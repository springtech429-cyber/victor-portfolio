# Supabase project (Project Settings > API). Both values are safe to expose in the browser:
# Row Level Security in supabase/schema.sql is what protects your data.
# The older VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY names still work too.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Your live address, used for canonical links, the sitemap and share previews.
# Vercel sets this automatically; only needed if you use a custom domain and want it explicit.
NEXT_PUBLIC_SITE_URL=

# Optional: paste the verification codes Google Search Console / Bing Webmaster Tools give you (the content="..." value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
